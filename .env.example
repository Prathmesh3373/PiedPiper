
# Gemini is the only LLM brain used by this application.
TOURISM_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Recommended fast model. Also works with gemini-2.5-pro for more complex reasoning.
GEMINI_MODEL=gemini-2.5-flash

# Chat latency guardrails.
# Increase timeout if you switch to gemini-2.5-pro (it reasons longer).
TOURISM_LLM_TIMEOUT_SECONDS=30
TOURISM_WEB_TIMEOUT_SECONDS=8

# Set to 1 to enable an extra LLM pass over web snippets to extract nearby places.
# Keep 0 (default) — the deterministic extractor already handles it faster.
TOURISM_LLM_SNIPPET_EXTRACTION=0

# Tavily gives far richer web results than the Wikipedia fallback.
# Get a free key at https://tavily.com/
TAVILY_API_KEY=

# Optional — live weather from OpenWeatherMap when no web weather snippet is found.
OPENWEATHER_API_KEY=

# Set to 0 to run the agent fully offline / deterministic (no Gemini calls).
TOURISM_LLM_BRAIN=1

# Set to 0 to skip the LLM slot-extraction step in offline/test mode.
TOURISM_LLM_SLOTS=1
